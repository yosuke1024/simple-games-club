{
  "name": "simple-games-club",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Club House server for Simple Games by PixApps — one deployment is one club, as a Node process with SQLite or as a Cloudflare Worker with a Durable Object",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:worker": "wrangler deploy --dry-run --outdir dist-worker",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "dev": "pnpm build && CLUB_DATA_DIR=./data pnpm start",
    "dev:worker": "wrangler dev",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:workers": "vitest run --project workers",
    "test:watch": "vitest",
    "measure:rows": "pnpm build:worker && node scripts/measure-rows.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.5.0",
    "eslint": "^10.8.0",
    "miniflare": "5.20261001.0-alpha",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.146.0"
  }
}
